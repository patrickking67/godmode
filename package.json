{
  "name": "godmode",
  "version": "1.3.0",
  "description": "Learn, plan, build, and optimize: one dual-engine super-plugin for Claude Code and Codex with hero workflows, bundled subagents and hooks, and ten no-auth MCP servers. Persistent memory, token economics, and a live dashboard are on the roadmap.",
  "license": "Apache-2.0",
  "author": "Patrick King",
  "homepage": "https://github.com/patrickking67/godmode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickking67/godmode.git"
  },
  "bugs": {
    "url": "https://github.com/patrickking67/godmode/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "plugin",
    "memory",
    "subagents",
    "mcp",
    "tokens",
    "dashboard"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "plugin",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsx scripts/build-plugin.ts",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "pnpm build:plugin && pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "validate:plugin": "claude plugin validate --strict . && claude plugin validate --strict ./plugin"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.13.16",
    "ulidx": "^2.4.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
