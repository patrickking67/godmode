{
  "name": "Godmode",
  "version": "1.0.0",
  "description": "Learn, plan, build, and optimize — one super-plugin for agentic coding tools, with persistent memory, token economics, bundled MCPs, and a live local webviewer.",
  "license": "Apache-2.0",
  "author": "Patrick King",
  "homepage": "https://github.com/patrickking67/godmode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickking67/godmode.git"
  },
  "bugs": {
    "url": "https://github.com/patrickking67/godmode/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "plugin",
    "memory",
    "subagents",
    "mcp",
    "tokens",
    "dashboard"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "godmode": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/dev.ts",
    "build": "tsc -p tsconfig.build.json && vite build && node scripts/build-plugin.ts",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "doctor": "tsx src/cli/doctor.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.12.23",
    "ulidx": "^2.4.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
