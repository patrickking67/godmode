{
  "name": "godmode",
  "version": "1.3.0",
  "description": "One plugin for Claude Code and Codex, built from a single source: nine coding workflow skills and ten no-auth MCP servers, plus five subagents and three hooks for Claude Code.",
  "license": "Apache-2.0",
  "author": "Patrick King",
  "homepage": "https://patrickking67.github.io/godmode/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickking67/godmode.git"
  },
  "bugs": {
    "url": "https://github.com/patrickking67/godmode/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "plugin",
    "agent-skills",
    "mcp",
    "subagents",
    "hooks"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "plugin",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsx scripts/build-plugin.ts",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "pnpm build:plugin && pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "validate:plugin": "claude plugin validate --strict . && claude plugin validate --strict ./plugin"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.7",
    "ajv": "^8.20.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
